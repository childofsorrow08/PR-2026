    </text:list-style>
    <style:style style:name="background" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#f4f7f8" draw:stroke="solid" svg:stroke-color="#f4f7f8" fo:padding="0.15cm" draw:textarea-vertical-align="middle" />
    </style:style>
    <style:style style:name="box" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#ffffff" draw:stroke="solid" svg:stroke-color="#b7c9cb" fo:padding="0.15cm" draw:textarea-vertical-align="middle" />
    </style:style>
    <style:style style:name="header" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#155a61" draw:stroke="solid" svg:stroke-color="#b7c9cb" fo:padding="0.15cm" draw:textarea-vertical-align="middle" />
    </style:style>
    <style:style style:name="button" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#e0eeef" draw:stroke="solid" svg:stroke-color="#43838a" fo:padding="0.15cm" draw:textarea-vertical-align="middle" />
