  <office:master-styles>
    <draw:layer-set>
      <draw:layer draw:name="layout" />
      <draw:layer draw:name="background" />
      <draw:layer draw:name="backgroundobjects" />
      <draw:layer draw:name="controls" />
      <draw:layer draw:name="measurelines" />
    </draw:layer-set>
    <style:master-page style:name="Default" style:page-layout-name="PM0" draw:style-name="dp1">
      <loext:theme loext:name="Office">
        <loext:theme-colors loext:name="LibreOffice">
          <loext:color loext:name="dark1" loext:color="#000000" />
          <loext:color loext:name="light1" loext:color="#ffffff" />
          <loext:color loext:name="dark2" loext:color="#000000" />
          <loext:color loext:name="light2" loext:color="#ffffff" />
          <loext:color loext:name="accent1" loext:color="#18a303" />
          <loext:color loext:name="accent2" loext:color="#0369a3" />
          <loext:color loext:name="accent3" loext:color="#a33e03" />
          <loext:color loext:name="accent4" loext:color="#8e03a3" />
          <loext:color loext:name="accent5" loext:color="#c99c00" />
          <loext:color loext:name="accent6" loext:color="#c9211e" />
          <loext:color loext:name="hyperlink" loext:color="#0000ee" />
          <loext:color loext:name="followed-hyperlink" loext:color="#551a8b" />
        </loext:theme-colors>
      </loext:theme>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:drawing>
      <draw:page draw:name="details" draw:master-page-name="Default">
        <draw:rect draw:style-name="background" draw:text-style-name="text" svg:x="0cm" svg:y="0cm" svg:width="28cm" svg:height="21cm">
          <text:p text:style-name="text"></text:p>
        </draw:rect>
        <draw:rect draw:style-name="header" draw:text-style-name="text" svg:x="0cm" svg:y="0cm" svg:width="28cm" svg:height="1.3cm">
          <text:p text:style-name="white">PostService  /  Облік поштових відправлень</text:p>
        </draw:rect>
        <draw:rect draw:style-name="button" draw:text-style-name="text" svg:x="0.6cm" svg:y="1.7cm" svg:width="4cm" svg:height="1cm">
          <text:p text:style-name="text">Головна</text:p>
        </draw:rect>
        <draw:rect draw:style-name="button" draw:text-style-name="text" svg:x="4.9cm" svg:y="1.7cm" svg:width="6cm" svg:height="1cm">
          <text:p text:style-name="text">Відправлення</text:p>
        </draw:rect>
        <draw:rect draw:style-name="button" draw:text-style-name="text" svg:x="11.2cm" svg:y="1.7cm" svg:width="5cm" svg:height="1cm">
          <text:p text:style-name="text">Про програму</text:p>
        </draw:rect>
        <draw:rect draw:style-name="title" draw:text-style-name="text" svg:x="0.7cm" svg:y="3.2cm" svg:width="26.6cm" svg:height="1.2cm">
          <text:p text:style-name="text">Деталі відправлення № UA001</text:p>
        </draw:rect>
        <draw:rect draw:style-name="box" draw:text-style-name="text" svg:x="1cm" svg:y="4.9cm" svg:width="26cm" svg:height="9cm">
          <text:p text:style-name="text">Номер: UA001</text:p>
          <text:p text:style-name="text">Відправник: Київ     Одержувач: Львів</text:p>
          <text:p text:style-name="text">Вміст: Книги     Тип доставки: Відділення</text:p>
          <text:p text:style-name="text">Вага: 2 кг     Ширина: 20 см     Висота: 10 см     Довжина: 30 см</text:p>
          <text:p text:style-name="text">Оголошена цінність: 500 грн     Вартість пересилання: 100 грн</text:p>
          <text:p text:style-name="text">Створено: 09.11.2026 10:00</text:p>
          <text:p text:style-name="text">Інформація лише для перегляду.</text:p>
        </draw:rect>
        <draw:rect draw:style-name="button" draw:text-style-name="text" svg:x="1cm" svg:y="14.9cm" svg:width="7cm" svg:height="1cm">
          <text:p text:style-name="text">← До списку</text:p>
        </draw:rect>
        <draw:rect draw:style-name="label" draw:text-style-name="text" svg:x="0.6cm" svg:y="19.5cm" svg:width="26.8cm" svg:height="0.8cm">
          <text:p text:style-name="text">Вебзастосунок · Широкий екран</text:p>
        </draw:rect>
      </draw:page>
    </office:drawing>
  </office:body>
</office:document>